# ============================================================
# MixedRelay .gitignore
# Public repository profile
# ============================================================


# ------------------------------------------------------------
# Runtime data
# ------------------------------------------------------------
data/
logs/
log/
tmp/
temp/

# Channel logs / cursors / archives generated by mrelayd
**/channels/
**/cursors.json
**/archive/
**/log.jsonl

# MCP bridge lifecycle/runtime state
mrelay-mcp/mrelay_mcp/instance_registry.json
mrelay-mcp/mrelay_mcp/instance_registry.lock
mrelay-mcp/mrelay_mcp/lifecycle_events.jsonl

# Local development notes
dev-notes/


# ------------------------------------------------------------
# Local environment / secrets / machine-specific config
# ------------------------------------------------------------
.env
.env.*
*.local
*.local.*
*.secret
*.secret.*
*.token
*.token.*
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr

# MCP / client local config examples should be committed as *.example.* only
*.private.*
*.personal.*


# ------------------------------------------------------------
# Go build artifacts
# ------------------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof
*.coverprofile
coverage.*
profile.cov

# Go workspace files are local-machine state
go.work
go.work.sum

# Dependency vendor is not ignored by default.
# Uncomment only if this repository intentionally never commits vendor/.
# vendor/


# ------------------------------------------------------------
# Python cache / virtual environments / packaging
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

.venv/
venv/
env/
ENV/

build/
dist/
*.egg-info/
pip-wheel-metadata/


# ------------------------------------------------------------
# Node / frontend artifacts
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------------------------
# Editor / IDE
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/


# ------------------------------------------------------------
# OS / filesystem noise
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini


# ------------------------------------------------------------
# Windows shortcuts / local launch residue
# ------------------------------------------------------------
*.lnk
*.url


# ------------------------------------------------------------
# Logs and crash dumps
# ------------------------------------------------------------
*.log
*.pid
*.pid.lock
*.stackdump
crashdump/
